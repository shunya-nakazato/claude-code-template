{
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  },
  "language": "japanese",
  "plansDirectory": "./.claude/plans",
  "permissions": {
    "allow": [
      "Write(.claude/plans/**)",
      "Edit(.claude/plans/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/bash-checker.sh",
            "statusMessage": "Bashコマンドチェック中..."
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(git commit*)",
            "command": "bash .claude/hooks/gitleaks-pre-commit.sh",
            "timeout": 120,
            "statusMessage": "コミット前の gitleaks スキャン実行中..."
          }
        ]
      }
    ]
  },
  "teammateMode": "auto"
}
